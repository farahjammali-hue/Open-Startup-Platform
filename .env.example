# ---- Database (Neon / any Postgres) ----
DATABASE_URL=postgresql://user:password@host/dbname?sslmode=require

# ---- Session ----
SESSION_SECRET=change-me-to-a-long-random-string

# ---- Server ----
PORT=5000
NODE_ENV=development
# Public base URL of the app (used for OAuth callback)
APP_URL=http://localhost:5000

# ---- Google OAuth ----
# Create credentials at https://console.cloud.google.com/apis/credentials
# Authorized redirect URI: {APP_URL}/api/auth/google/callback
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=

# ---- Email (Google Workspace SMTP) ----
SMTP_HOST=smtp.gmail.com
SMTP_PORT=587
SMTP_USER=you@open-startup.org
SMTP_PASS=your-16-char-app-password
SMTP_FROM=you@open-startup.org

# ---- Captcha (Google reCAPTCHA v2) ----
RECAPTCHA_SITE_KEY=
RECAPTCHA_SECRET_KEY=

# ---- Admin access ----
ADMIN_EMAILS=you@open-startup.org

# ---- Zoom (Server-to-Server OAuth app, for Mentorship/Training recording sync) ----
# Optional — leave blank to disable. Create at https://marketplace.zoom.us
ZOOM_ACCOUNT_ID=
ZOOM_CLIENT_ID=
ZOOM_CLIENT_SECRET=
ZOOM_WEBHOOK_SECRET_TOKEN=
