# ============================================================
# Production config for platform.open-startup.org
# ============================================================
# Copy this file to `.env` in the REPO ROOT (not inside deploy/) and fill
# in the values marked below. NEVER commit `.env` — it's already covered
# by .gitignore's ".env*" pattern... double check that before deploying.
#
# Anything left blank below is OPTIONAL: the app detects missing keys and
# disables that feature gracefully (see the report for exactly what happens
# in each case).

# ---- Database (REQUIRED) ----
# docker-compose.yml starts a PostgreSQL container dedicated to this platform
# (`ost-platform-db`). These three values create it on first start, and are
# ignored afterwards: changing the password here does NOT change it in an
# existing database.
#
# compose reads these from the command line, not from the container's
# environment, so every compose command needs --env-file .env.
POSTGRES_DB=ost_platform
POSTGRES_USER=ost_platform_user
POSTGRES_PASSWORD=REPLACE_WITH_A_LONG_RANDOM_PASSWORD

# The app's connection string. The host is the database CONTAINER's name, which
# resolves only on the private compose network: not from the host, not from the
# internet. The three values below MUST match the three above, or the app will
# fail to authenticate against its own database.
#
# No "sslmode=require": the app detects a plain local Postgres and connects
# without TLS, which is correct for a private container network.
DATABASE_URL=postgresql://ost_platform_user:REPLACE_WITH_A_LONG_RANDOM_PASSWORD@ost-platform-db:5432/ost_platform

# ---- Session (REQUIRED) ----
# Any long random string. Generate one with:  openssl rand -hex 32
SESSION_SECRET=REPLACE_WITH_A_LONG_RANDOM_STRING

# ---- Server (REQUIRED) ----
PORT=5000
NODE_ENV=production
APP_URL=https://platform.open-startup.org

# ---- Admin access (REQUIRED) ----
# Comma-separated list of email addresses that should have admin rights.
# These are just email strings the app checks against on login — no external
# account needed. Use your teammates' real emails so they can sign up
# normally and immediately get admin access.
ADMIN_EMAILS=you@open-startup.org,teammate@open-startup.org

# ---- Super admin (OPTIONAL, testing only — leave blank normally) ----
# Comma-separated list of admin emails allowed to permanently delete a user
# and their startup (Admin > Users > "Delete forever"). This bypasses every
# cascade-safety the app otherwise relies on and cannot be undone — narrower
# and more dangerous than plain admin access, so keep this list as short as
# possible and blank it out once you're done cycling through test accounts.
SUPER_ADMIN_EMAILS=

# ---- Calendar invites (OPTIONAL — "off" sends nothing) ----
# How scheduled Mentorship/Training sessions reach founders' calendars.
#
#   off    (default) The platform creates the Zoom meeting and shows the join
#          link in-app, but sends no calendar invite.
#   ics    Emails an iCalendar invite when a session is created, edited or
#          cancelled. A Mentorship session is 1:1, so it goes to that startup
#          only; Training is programme-wide, so it goes to every founder.
#          Admins and the session's Zoom host are always included.
#          Works with Google, Outlook and Apple Calendar. Requires the SMTP
#          settings below; with SMTP unset, invites are logged instead of sent.
#   google Reserved for the Google Calendar API integration (not yet built).
#
# Pick ONE mechanism. Each creates its own calendar entry, so enabling two
# puts the same session in a founder's calendar twice. Zoom's own calendar
# sync (configured inside Zoom, per host account) is a THIRD mechanism: leave
# it switched off unless this is set to "off".
CALENDAR_INVITES=off

# ---- Google OAuth (OPTIONAL — leave blank to disable "Continue with Google") ----
#   Authorized origin:   https://platform.open-startup.org
#   Authorized redirect: https://platform.open-startup.org/api/auth/google/callback
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=

# ---- Email / SMTP (OPTIONAL — leave blank and verification links print to
#      the container logs instead of being emailed) ----
SMTP_HOST=smtp.gmail.com
SMTP_PORT=587
SMTP_USER=
SMTP_PASS=
SMTP_FROM=

# ---- Captcha (OPTIONAL — leave blank and the captcha box simply won't appear) ----
RECAPTCHA_SITE_KEY=
RECAPTCHA_SECRET_KEY=

# ---- Claude connector (OPTIONAL overrides — the defaults are the secure ones) ----
# Lets the team's own Claude (claude.ai / Desktop / Cowork, on your paid seats)
# read platform data and save mentorship session recaps at https://<APP_URL>/mcp.
# No AI API key is needed anywhere in the platform. Only ACTIVE ADMINS whose email is
# on one of these domains can connect, re-checked on every request:
# MCP_ALLOWED_EMAIL_DOMAINS=open-startup.org
# Where approvals may be returned to (Claude's own hosts; local http callbacks
# for Claude Desktop/Code are always allowed). Don't add anything else here.
# MCP_ALLOWED_REDIRECT_HOSTS=claude.ai,claude.com

# ---- KYC Typeform webhook ----
# The founder KYS step embeds the "KYC & Compliance Form" Typeform. Its
# webhook (Typeform: form > Connect > Webhooks, URL
# https://<APP_URL>/api/typeform/webhook) sends the program answer, which sets
# the startup's track. Use the same secret here and in Typeform's webhook
# "Secret" setting. Blank = webhook disabled (admins set tracks by hand).
TYPEFORM_WEBHOOK_SECRET=

# ---- Adobe Acrobat Sign webhook ----
# Step 1 of Contract & KYS embeds an Acrobat Sign web form (the declaration).
# An Adobe Sign account admin creates a webhook (Account Settings > Webhooks)
# for "Agreement workflow completed" with "Agreement info", "Participant info"
# and "Include signed documents" enabled, pointed at
# https://<APP_URL>/api/adobe-sign/webhook. Put that webhook's OAuth
# application client id here; requests without it are refused. Blank =
# webhook off (signing still works; the platform just can't show the PDF).
ADOBE_SIGN_WEBHOOK_CLIENT_ID=
